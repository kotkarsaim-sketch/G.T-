# ---------------------------------------------------------------------------
# CivicGraph environment configuration (copy to .env and adjust)
# Values here are suitable for local development only.
# ---------------------------------------------------------------------------

# --- API service ---
CIVIC_ENVIRONMENT=dev
CIVIC_LOG_LEVEL=INFO

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-dev
NEO4J_DATABASE=neo4j

# --- Embeddings (TEI serving bge-m3 by default) ---
EMBEDDING_BASE_URL=http://localhost:8081
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024

# --- LLM gateway ---
# provider: openai | azure | anthropic | local (any OpenAI-compatible endpoint)
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:14b-instruct
LLM_API_KEY=
LLM_TIMEOUT_S=60

# --- Retrieval tuning ---
RETRIEVAL_VECTOR_K=40
RETRIEVAL_FULLTEXT_K=40
RETRIEVAL_FINAL_K=8
RETRIEVAL_MIN_SCORE=0.35
ENABLE_RERANK=false
RERANKER_BASE_URL=

# --- Web client ---
NEXT_PUBLIC_API_BASE=http://localhost:8000

# --- Admin API (/v1/admin/*) ---
# Mode 1 (production): OIDC via the municipal IdP; tokens must carry a
#   civic-admin role. Set OIDC_ISSUER (and OIDC_AUDIENCE if the IdP enforces one).
# OIDC_ISSUER=https://idp.municipality.example.org/realms/city
# OIDC_AUDIENCE=civicgraph
# Mode 2 (bootstrap/automation): static bearer token.
# ADMIN_TOKEN=change-me-long-random
# Mode 3: nothing set + CIVIC_ENVIRONMENT=dev -> admin routes are open (warned
#   at startup). Production with nothing set fails closed.

# --- Compose-only settings ---
NEO4J_CONTAINER_PASSWORD=change-me-dev
